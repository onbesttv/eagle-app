<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061328">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app_futuristic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33020A17"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="104dp"
        android:layout_height="96dp"
        android:layout_marginTop="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/eagle_wordmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_icon_button"
        android:focusable="true"
        android:contentDescription="Definições"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnUpdateService"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_icon_button"
        android:focusable="true"
        android:contentDescription="Atualizar conteúdo do serviço"
        android:padding="10dp"
        android:src="@drawable/ic_refresh"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="85dp"
        android:paddingEnd="85dp"
        app:layout_constraintBottom_toTopOf="@id/cardCatchUp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo">

        <!-- LIVE TV -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLiveTv"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:focusedByDefault="true"
            android:nextFocusDown="@+id/cardCatchUp"
            android:foreground="@drawable/fg_home_card_selector"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="@android:color/transparent">
            <requestFocus />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:duplicateParentState="true"
                android:background="@drawable/bg_home_tile_glass">
                <ImageView
                    android:id="@+id/ivLiveTvIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_home_live_tv" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE TV"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.05"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TV GUIDE -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEpg"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/cardCatchUp"
            android:foreground="@drawable/fg_home_card_selector"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="@android:color/transparent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:duplicateParentState="true"
                android:background="@drawable/bg_home_tile_glass">
                <ImageView
                    android:id="@+id/ivGuideIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_home_guide" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV GUIDE"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.05"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- MOVIES -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMovies"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/cardCatchUp"
            android:foreground="@drawable/fg_home_card_selector"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="@android:color/transparent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:duplicateParentState="true"
                android:background="@drawable/bg_home_tile_glass">
                <ImageView
                    android:id="@+id/ivMoviesIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_home_movies" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOVIES"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.05"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SERIES -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSeries"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/cardCatchUp"
            android:foreground="@drawable/fg_home_card_selector"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="@android:color/transparent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:duplicateParentState="true"
                android:background="@drawable/bg_home_tile_glass">
                <ImageView
                    android:id="@+id/ivSeriesIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_home_series" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERIES"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.05"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- CATCH UP -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCatchUp"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:nextFocusUp="@+id/cardMovies"
        android:nextFocusDown="@+id/cardCatchUp"
        android:foreground="@drawable/fg_home_card_selector"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:duplicateParentState="true"
            android:background="@drawable/bg_home_tile_glass">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_catchup"
                app:tint="#F0FBFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="CATCH UP"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>