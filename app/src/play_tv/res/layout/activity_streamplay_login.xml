<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07040B">

    <ImageView
        android:id="@+id/ivLoginBgFuturistic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app_futuristic" />

    <View
        android:id="@+id/viewLoginBgOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <ImageView
            android:id="@+id/ivJokerAppLogoLogin"
            android:layout_width="140dp"
            android:layout_height="70dp"
            android:scaleType="fitCenter"
            android:contentDescription="PlayTV"
            android:src="@drawable/eagle_wordmark"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardServiceLogin"
            android:layout_width="450dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#E6151419"
            app:cardCornerRadius="22dp"
            app:cardElevation="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="22dp"
                android:paddingEnd="30dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:id="@+id/tvLoginServiceBrand"
                    android:letterSpacing="0.25"
                    android:text="INICIAR SESSÃO"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutDnsSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_dns_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:nextFocusDown="@+id/etServiceUsername"
                    android:nextFocusUp="@+id/layoutDnsSelector"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Servidor"
                        android:src="@drawable/ic_server_network"
                        app:tint="#0284C7" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERVIDOR / DNS DO PAINEL"
                            android:textColor="#8E9EB5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvSelectedDnsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:text="Servidor 1"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="#0284C7"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etServiceUsername"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_auth_input"
                    android:drawableStart="@drawable/ic_auth_user"
                    android:drawablePadding="12dp"
                    android:drawableTint="#0284C7"
                    android:hint="Username"
                    android:inputType="text"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="#0284C7"
                    android:textColorHint="#60A5FA"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:nextFocusUp="@+id/layoutDnsSelector"
                    android:nextFocusDown="@+id/etServicePassword" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp">

                    <EditText
                        android:id="@+id/etServicePassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="password"
                        android:background="@drawable/bg_auth_input"
                        android:drawableStart="@drawable/ic_auth_lock"
                        android:drawablePadding="12dp"
                        android:drawableTint="#0284C7"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:paddingStart="15dp"
                        android:paddingEnd="46dp"
                        android:singleLine="true"
                        android:textColor="#0284C7"
                        android:textColorHint="#60A5FA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:nextFocusDown="@+id/btnServiceLogin" />

                    <ImageButton
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="48dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_vertical|end"
                        android:background="@android:color/transparent"
                        android:contentDescription="Mostrar password"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_visibility_off"
                        android:focusable="false"
                        app:tint="#0284C7" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvServiceLoginStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FF4D4D"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/pbServiceLogin"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="14dp"
                    android:indeterminateTint="#EF4444"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnServiceLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_auth_action"
                    android:text="ENTRAR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:nextFocusUp="@+id/etServicePassword"
                    android:nextFocusDown="@+id/btnChooseService" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/autoLoginProgressPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:contentDescription="PlayTV"
            android:scaleType="fitCenter"
            android:src="@drawable/eagle_wordmark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:id="@+id/tvAutoLoginServiceBrand"
            android:letterSpacing="0.28"
            android:text="PLAYTV"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbAutoLogin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#EF4444" />

        <TextView
            android:id="@+id/tvAutoLoginStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="A verificar a conta…"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnChooseService"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="Escolher serviço"
        android:padding="12dp"
        android:src="@drawable/ic_settings"
        android:focusable="true"
        android:nextFocusUp="@+id/btnServiceLogin"
        app:tint="#FFFFFF" />
</FrameLayout>
