<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090E">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app_futuristic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#37020914" />

    <LinearLayout
        android:id="@+id/serviceChoices"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_auth_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="26dp"
        android:paddingEnd="32dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/tvServiceSelectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:letterSpacing="0.24"
            android:text="SELECT PANEL"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardStreamPlay"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_service_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:contentDescription="Televisão"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_service_tv"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="BEST"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBestCheck"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:text="✓"
                android:textColor="#42D6E8"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardOtherService"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_service_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:contentDescription="Televisão"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_service_tv"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="BEST2"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBest2Check"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:text="✓"
                android:textColor="#42D6E8"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/autoLoginPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="Televisão"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_service_tv"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:id="@+id/tvStartupServiceBrand"
            android:letterSpacing="0.28"
            android:text="STREAMPLAY"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbServiceSelection"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#42D6E8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="A preparar a tua biblioteca…"
            android:textColor="#F2F4F8"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
