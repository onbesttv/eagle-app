<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#7C3AED" />
            <stroke android:width="1.5dp" android:color="#FBBF24" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#3B1C6E" />
            <stroke android:width="2dp" android:color="#FBBF24" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1A102E" />
            <stroke android:width="1dp" android:color="#36225B" />
        </shape>
    </item>
</selector>
