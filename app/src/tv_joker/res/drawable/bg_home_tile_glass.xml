<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Quando o cartão tem Foco (navegação comando Box) - Destaque Ouro/Púrpura Joker -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#F59E0B"
                android:centerColor="#7C3AED"
                android:endColor="#2E1065" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#D97706"
                android:centerColor="#6D28D9"
                android:endColor="#1E0B38" />
        </shape>
    </item>
    <!-- Estado normal: vidro fumado preto-púrpura com subtil rebordo dourado -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#EC0A0612" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1.3dp"
                        android:color="#44F59E0B" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
