<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07040B">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#07040B" />

    <!-- TOP HEADER BAR -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_arrow_borderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:clickable="true"
            app:tint="#FBBF24" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CENTRO DE AJUDA &amp; EXTRAS"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tutoriais Passo a Passo &amp; Despistes Rápidos"
                android:textColor="#FBBF24"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Category Filters -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_extra_filter_chip"
                    android:text="Todas (11)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/chipDespistes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_extra_filter_chip"
                    android:text="⚠️ Despistes"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/chipInternet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_extra_filter_chip"
                    android:text="🌐 Internet"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/chipVpn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_extra_filter_chip"
                    android:text="🔒 VPN"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/chipDevices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_extra_filter_chip"
                    android:text="📱 Telemóvel &amp; PC"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- GRID RECYCLERVIEW COM OS CARDS DE PERGUNTAS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExtras"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- OVERLAY FULLSCREEN IMAGE VIEWER -->
    <FrameLayout
        android:id="@+id/flViewerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA040207"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Top Controls Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:background="#E607040B">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvViewerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Título da Pergunta"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvViewerCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tutorial 1 de 11"
                    android:textColor="#FBBF24"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnViewerClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_extra_filter_chip"
                android:text="✕ FECHAR"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- Main Image Container -->
        <ImageView
            android:id="@+id/ivViewerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="Guia Completo" />

        <!-- Floating Previous Button -->
        <ImageButton
            android:id="@+id/btnViewerPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_arrow_borderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Anterior"
            android:focusable="true"
            android:clickable="true"
            app:tint="#FBBF24" />

        <!-- Floating Next Button -->
        <ImageButton
            android:id="@+id/btnViewerNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:rotation="180"
            android:background="@drawable/bg_arrow_borderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Seguinte"
            android:focusable="true"
            android:clickable="true"
            app:tint="#FBBF24" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
