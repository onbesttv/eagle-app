<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Vídeo Fullscreen sem nenhum controlo nativo no ecrã -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- Botão Discreto no Canto Superior Esquerdo para abrir a Grelha -->
    <ImageView
        android:id="@+id/btnToggleChannelOverlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_channel_list"
        android:contentDescription="Abrir lista de canais" />

    <!-- Área de Toque Invisível para Fechar a Grelha com Touch fora dela -->
    <View
        android:id="@+id/viewOverlayDismissArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Barra Lateral de Canais (Overlay) -->
    <LinearLayout
        android:id="@+id/layoutChannelOverlay"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:orientation="vertical"
        android:background="#E60A0F14"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Cabeçalho limpo sem o 'X' -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#16202C">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CANAIS"
                android:textColor="#4D96FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOverlayChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</RelativeLayout>