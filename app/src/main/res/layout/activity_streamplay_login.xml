<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_surface">

    <ImageButton
        android:id="@+id/btnChooseService"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="Escolher serviço"
        android:src="@drawable/ic_settings"
        app:tint="#FFFFFF" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardServiceLogin"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardBackgroundColor="#121D2D"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="30dp">

            <ImageView
                android:layout_width="112dp"
                android:layout_height="58dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:text="LOGIN STREAMPLAY"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.06"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etServiceUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:autofillHints="username"
                android:background="@drawable/bg_input_field"
                android:hint="Username"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9BAAC0" />

            <EditText
                android:id="@+id/etServicePassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:autofillHints="password"
                android:background="@drawable/bg_input_field"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9BAAC0" />

            <TextView
                android:id="@+id/tvServiceLoginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#FF7777"
                android:textSize="13sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbServiceLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnServiceLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#397DFF"
                android:letterSpacing="0.08"
                android:text="LOGIN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/autoLoginProgressPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbAutoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvAutoLoginStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="A verificar a conta…"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
