<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E">

    <ImageView
        android:id="@+id/ivActivationBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app_futuristic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC02060F" />

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_auth_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/ivActivationLogo"
            android:layout_width="160dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/eagle_wordmark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="ATIVAÇÃO DO DISPOSITIVO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Indica estes dados ao teu fornecedor para ativar a tua aplicação."
            android:textColor="#8EA6C1"
            android:textSize="12sp" />

        <!-- Cartão Device ID (MAC) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_service_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEVICE ID / MAC"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="00:1A:79:00:00:00"
                android:textColor="#38BDF8"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Estado de Ativação -->
        <TextView
            android:id="@+id/tvActivationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="● A aguardar ativação no painel..."
            android:textColor="#FBBF24"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Botão Principal: Verificar Ativação -->
        <Button
            android:id="@+id/btnCheckActivation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_selector"
            android:elevation="4dp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:letterSpacing="0.08"
            android:text="🔄 VERIFICAR ATIVAÇÃO"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
