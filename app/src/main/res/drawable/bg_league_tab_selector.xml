<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0284C7" />
            <stroke android:width="1.2dp" android:color="#38BDF8" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0369A1" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#E60A101D" />
            <stroke android:width="1.2dp" android:color="#23324A" />
        </shape>
    </item>
</selector>
