<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="10dp"
    android:focusable="true"
    android:clickable="true">

    <!-- Número do Canal Estilo TiviMate / Formuler -->
    <TextView
        android:id="@+id/tvChannelNumber"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Logótipo do Canal -->
    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="38dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <!-- Coluna Central: Nome + Badges + EPG Inline + Barra de Progresso -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlayingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="▶"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Canal HD"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCatchupBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="⏪"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFavStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="★"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInlineEpgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Emissão em direto"
            android:textColor="#7DD3FC"
            android:textSize="10.5sp" />

        <ProgressBar
            android:id="@+id/pbInlineEpg"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#1E293B"
            android:progressTint="#00E5FF" />

    </LinearLayout>

</LinearLayout>
