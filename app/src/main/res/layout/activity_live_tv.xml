<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLiveLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D16"
    android:keepScreenOn="true">

    <!-- ESTRUTURA PRINCIPAL (DIVIDIDA) -->
    <LinearLayout
        android:id="@+id/layoutMainSplit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- PAINÉIS DA ESQUERDA (CATEGORIAS E CANAIS) -->
        <LinearLayout
            android:id="@+id/layoutLeftPanels"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Coluna Categorias -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#101827">

                <!-- Barra Superior com Botão Sair/Voltar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp">

                    <ImageButton
                        android:id="@+id/btnBackLiveTv"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Voltar"
                        android:src="@android:drawable/ic_menu_revert"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="CATEGORIAS"
                        android:textColor="#65A5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#23324A" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#23324A" />

            <!-- Coluna Canais com Pesquisa -->
            <LinearLayout
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#0C1422">

                <EditText
                    android:id="@+id/etSearchChannel"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Pesquisar canal..."
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:textColorHint="#8392A8"
                    android:textColor="#FFFFFF"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#23324A" />
        </LinearLayout>

        <!-- PAINEL DA DIREITA (VÍDEO + EPG) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#000000">

            <!-- Contentor do Vídeo -->
            <RelativeLayout
                android:id="@+id/layoutVideoContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/miniPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:surface_type="surface_view"
                    app:resize_mode="fit"
                    app:use_controller="false" />

                <!-- Toque para alternar ecrã inteiro / normal -->
                <View
                    android:id="@+id/viewPlayerClickTarget"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="false" />
            </RelativeLayout>

            <!-- Painel EPG Inferior -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutBottomEpg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:gravity="center_vertical">

                    <!-- Linha 1: Info e Título -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivEpgChannelLogo"
                            android:layout_width="32dp"
                            android:layout_height="22dp"
                            android:scaleType="fitCenter"
                            android:src="@mipmap/ic_launcher" />

                        <TextView
                            android:id="@+id/tvEpgChannelName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Canal"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/tvEpgBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="#2E7D32"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="NO AR"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvEpgCurrentTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="A carregar emissão..."
                            android:textColor="#F5C56B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Linha 2: Barra de Progresso Fina + Horários -->
                    <LinearLayout
                        android:id="@+id/layoutEpgProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="3dp">

                        <ProgressBar
                            android:id="@+id/pbEpgProgram"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:progress="0"
                            android:max="100"
                            android:progressTint="#65A5FF"
                            android:progressBackgroundTint="#2C3E50" />

                        <TextView
                            android:id="@+id/tvEpgCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text=""
                            android:textColor="#8A99A8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Linha 3: Sinopse / Próximo Programa -->
                    <TextView
                        android:id="@+id/tvEpgCurrentDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="#8392A8"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvEpgNextTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#5C6B78"
                        android:textSize="10sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <!-- ÁREA DE DISMISS PARA A GAVETA DE CANAIS NO ECRÃ INTEIRO -->
    <View
        android:id="@+id/viewOverlayDismissArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- GAVETA LATERAL FLUTUANTE DE CANAIS (QUANDO EM FULLSCREEN) -->
    <LinearLayout
        android:id="@+id/layoutChannelOverlay"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:orientation="vertical"
        android:background="#E60A0F14"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:background="#16202C">

            <ImageButton
                android:id="@+id/btnBackOverlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Fechar lista"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="CANAIS"
                android:textColor="#65A5FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOverlayChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:overScrollMode="never" />
    </LinearLayout>

</RelativeLayout>
