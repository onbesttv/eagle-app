<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9080D16">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardParentalPin"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        app:cardBackgroundColor="#111827"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- Header horizontal compacto: Ícone + Título -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvPinDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Controlo Parental"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPinDialogSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Introduza o código PIN de 4 dígitos"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <!-- 4 PIN Dots -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/pinDot1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/pinDot2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/pinDot3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/pinDot4"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_pin_dot_empty" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPinError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Código PIN incorreto!"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Teclado Numérico Compacto -->
                <TableLayout
                    android:id="@+id/tableKeypad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:stretchColumns="0,1,2">

                    <TableRow android:layout_marginBottom="3dp">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin1"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin2"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin3"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="3dp">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin4"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="4"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin5"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="5"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin6"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="6"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="3dp">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin7"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="7"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin8"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="8"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin9"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="9"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="3dp">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPinDel"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="⌫"
                            android:textColor="#F59E0B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPin0"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPinOk"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pin_key_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="OK"
                            android:textColor="#10B981"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPinCancel"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Cancelar"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</FrameLayout>
