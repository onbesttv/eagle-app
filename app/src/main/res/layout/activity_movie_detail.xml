<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_surface">

    <!-- BOTÃO VOLTAR ATRÁS -->
    <ImageButton
        android:id="@+id/btnBackMovieDetail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voltar"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        android:elevation="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- POSTER -->
            <androidx.cardview.widget.CardView
                android:layout_width="220dp"
                android:layout_height="320dp"
                app:cardBackgroundColor="#121D2D"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/ivDetailPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />
            </androidx.cardview.widget.CardView>

            <!-- INFORMAÇÕES E AÇÕES -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Título do Filme"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 0.0"
                        android:textColor="#F5C56B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Ano • Género • Duração"
                        android:textColor="#8392A8"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="SINOPSE"
                    android:textColor="#65A5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="A carregar sinopse..."
                    android:textColor="#D0D6E0"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPlayMovie"
                        android:layout_width="160dp"
                        android:layout_height="48dp"
                        android:backgroundTint="#397DFF"
                        android:text="▶ Ver Filme"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:focusedByDefault="true"
                        android:nextFocusUp="@+id/btnBackMovieDetail"
                        android:nextFocusLeft="@+id/btnBackMovieDetail"
                        android:nextFocusRight="@+id/btnToggleFav">
                        <requestFocus />
                    </Button>

                    <Button
                        android:id="@+id/btnToggleFav"
                        android:layout_width="180dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:backgroundTint="#172338"
                        android:text="☆ Favorito"
                        android:textColor="#F5C56B"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
