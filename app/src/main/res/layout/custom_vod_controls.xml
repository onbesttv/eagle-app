<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <!-- BARRA SUPERIOR: Sair, Título e Botões de Áudio/Legendas -->
    <LinearLayout
        android:id="@+id/topBarControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Botão Sair / Voltar atrás -->
        <ImageButton
            android:id="@+id/btnBackVod"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sair"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <!-- Título do Filme / Episódio -->
        <TextView
            android:id="@+id/tvVodTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Botão de Áudio -->
        <ImageButton
            android:id="@+id/btnAudioTracks"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Áudios"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="#FFFFFF" />

        <!-- Botão de Legendas -->
        <ImageButton
            android:id="@+id/btnSubtitles"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Legendas"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="#FFFFFF" />

        <!-- Botão de Proporção de Ecrã (Ajustar / 16:9 / Zoom) -->
        <ImageButton
            android:id="@+id/btnAspectRatio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Proporção de ecrã"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- BOTÕES CENTRAIS (Recuar 10s, Play/Pause, Avançar 10s) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Recuar 10s"
            android:src="@android:drawable/ic_media_rew"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play ou Pause"
            android:src="@android:drawable/ic_media_play"
            app:tint="#65A5FF" />

        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Avançar 10s"
            android:src="@android:drawable/ic_media_ff"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- BARRA INFERIOR (Progresso e Duração) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            app:played_color="#65A5FF"
            app:scrubber_color="#65A5FF"
            app:unplayed_color="#555555" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#9BAAC0"
            android:textSize="13sp" />
    </LinearLayout>

</RelativeLayout>